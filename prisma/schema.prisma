// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRoles {
  ADMIN
  USER
  SUPERADMIN
}

enum ProducStatus {
  NEW
  OLD
  USED
}

enum UserStatus {
  ACTIVE
  PENDING
}

enum CategoryEnum {
  Phone
  Electronics
  Laptops
  Accessories
}

model Region {
  id   Int    @id @default(autoincrement())
  name String
  User User[]
}

model User {
  id              Int           @id @default(autoincrement())
  firstname       String
  lastname        String?
  email           String        @unique
  password        String
  role            UserRoles
  photo           String?
  region          Region        @relation(fields: [regionId], references: [id])
  regionId        Int
  status          UserStatus
  Products        Product[]
  Sessions        Sessions[]
  Likes           Likes[]
  Views           Views[]
  Order           Order[]
  Comments        Comments[]
  FromUser        Chat[]        @relation("FromUser")
  ToUser          Chat[]        @relation("ToUser")
  FromChatMessage ChatMessage[] @relation("FromUser")
  ToChatMessage   ChatMessage[] @relation("ToUser")
  createdAt       DateTime      @default(now())
}

model Product {
  id          Int          @id @default(autoincrement())
  photo       String?
  name        String
  description String
  status      ProducStatus
  price       Int
  count       Int
  discount    Int
  type        CategoryEnum
  user        User         @relation(fields: [userId], references: [id])
  userId      Int
  category    Category     @relation(fields: [categoryId], references: [id])
  categoryId  Int
  Color       Color[]      @relation("ColorProduct")
  Likes       Likes[]
  Views       Views[]
  Order       Order[]
  Comments    Comments[]
  createdAt   DateTime     @default(now())
}

model Category {
  id        Int          @id @default(autoincrement())
  name      String
  photo     String?
  type      CategoryEnum
  Products  Product[]
  createdAt DateTime     @default(now())
}

model Color {
  id      Int       @id @default(autoincrement())
  name    String
  Product Product[] @relation("ColorProduct")

  createdAt DateTime @default(now())
  Order     Order[]
}

model Sessions {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  ip        String?
  os        String?
  browser   String?
  device    String?
  createdAt DateTime @default(now())
}

model Likes {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
}

model Views {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  createdAt DateTime @default(now())
}

model Order {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  count     Int
  color     Color    @relation(fields: [colorId], references: [id])
  colorId   Int
  createdAt DateTime @default(now())
}

model Comments {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id])
  productId Int

  user   User @relation(fields: [userId], references: [id])
  userId Int

  text String
  star Int

  createdAt DateTime @default(now())
}

model Chat {
  id          Int           @id @default(autoincrement())
  fromUser    User          @relation("FromUser", fields: [fromId], references: [id])
  fromId      Int
  toUser      User          @relation("ToUser", fields: [toId], references: [id])
  toId        Int
  createdAt   DateTime      @default(now())
  ChatMessage ChatMessage[]
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  fromUser  User     @relation("FromUser", fields: [fromId], references: [id])
  fromId    Int
  toUser    User     @relation("ToUser", fields: [toId], references: [id])
  toId      Int
  text      String
  chat      Chat     @relation(fields: [chatId], references: [id])
  createdAt DateTime @default(now())
  chatId    Int
}
